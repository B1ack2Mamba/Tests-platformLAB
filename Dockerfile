# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:22-bookworm-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_ADMIN_EMAIL
ARG NEXT_PUBLIC_ADMIN_EMAILS
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_EMAIL_RECOVERY_ENABLED
ARG NEXT_PUBLIC_ENABLE_PWA
ARG NEXT_PUBLIC_GLOBAL_TEMPLATE_OWNER_EMAIL
ARG NEXT_PUBLIC_INVITE_BASE_URL
ARG NEXT_PUBLIC_PAYMENTS_ENABLED
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SPECIALIST_EMAILS
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_PROJECT_REGION
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_TEST_TAKE_PRICE_RUB
ARG NEXT_PUBLIC_TEST_UNLIMITED_EMAILS
ARG NEXT_PUBLIC_YOOKASSA_TEST_UI_ENABLED
ENV NEXT_PUBLIC_ADMIN_EMAIL=$NEXT_PUBLIC_ADMIN_EMAIL
ENV NEXT_PUBLIC_ADMIN_EMAILS=$NEXT_PUBLIC_ADMIN_EMAILS
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_EMAIL_RECOVERY_ENABLED=$NEXT_PUBLIC_EMAIL_RECOVERY_ENABLED
ENV NEXT_PUBLIC_ENABLE_PWA=$NEXT_PUBLIC_ENABLE_PWA
ENV NEXT_PUBLIC_GLOBAL_TEMPLATE_OWNER_EMAIL=$NEXT_PUBLIC_GLOBAL_TEMPLATE_OWNER_EMAIL
ENV NEXT_PUBLIC_INVITE_BASE_URL=$NEXT_PUBLIC_INVITE_BASE_URL
ENV NEXT_PUBLIC_PAYMENTS_ENABLED=$NEXT_PUBLIC_PAYMENTS_ENABLED
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SPECIALIST_EMAILS=$NEXT_PUBLIC_SPECIALIST_EMAILS
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_PROJECT_REGION=$NEXT_PUBLIC_SUPABASE_PROJECT_REGION
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_TEST_TAKE_PRICE_RUB=$NEXT_PUBLIC_TEST_TAKE_PRICE_RUB
ENV NEXT_PUBLIC_TEST_UNLIMITED_EMAILS=$NEXT_PUBLIC_TEST_UNLIMITED_EMAILS
ENV NEXT_PUBLIC_YOOKASSA_TEST_UI_ENABLED=$NEXT_PUBLIC_YOOKASSA_TEST_UI_ENABLED

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY package.json package-lock.json ./
COPY --from=deps /app/node_modules ./node_modules
RUN npm prune --omit=dev

COPY --from=builder --chown=node:node /app/.next ./.next
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/data ./data
COPY --from=builder /app/next.config.js ./next.config.js

USER node
EXPOSE 3000

CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]
