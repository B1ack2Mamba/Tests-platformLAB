# Copy to .env.timeweb.local in the project root. Never commit real credentials.
# Use separate staging domains and a restored database before the final cutover.
APP_DOMAIN=
# Bare-domain alias; use a separate alias for the rehearsal.
APP_REDIRECT_DOMAIN=
SUPABASE_DOMAIN=
ACME_EMAIL=
APP_IMAGE_TAG=timeweb-candidate

APP_URL=
APP_BASE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_INVITE_BASE_URL=

# All app URL values above: https://<APP_DOMAIN>
# Supabase URL below: https://<SUPABASE_DOMAIN> (no /auth/v1 suffix).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REGION=ru
NEXT_PUBLIC_SUPABASE_PROJECT_REGION=ru
APP_SERVER_PROVIDER=Timeweb Cloud
APP_SERVER_REGION=
APP_SERVER_CITY=
APP_SERVER_COUNTRY=Россия

# Gateway key is DIFFERENT from the Timeweb infrastructure API token and OpenAI key.
OPENAI_PROVIDER=timeweb
TIMEWEB_AI_API_KEY=
# Exact IDs shown in the Timeweb connection examples on 2026-10-16.
# Recheck access with `npm run preflight:timeweb -- --models` before deployment.
TIMEWEB_AI_MODEL_MAP={"gpt-5.6-terra":"openai/gpt-5.6-terra","gpt-5.6-sol":"openai/gpt-5.6-sol"}
OPENAI_TEST_MODEL=gpt-5.6-terra
OPENAI_PREMIUM_MODEL=gpt-5.6-terra
OPENAI_FINAL_MODEL=gpt-5.6-sol
OPENAI_AI_PLUS_MODEL=gpt-5.6-sol

# Copy existing role configuration deliberately; these are public build-time values.
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_EMAILS=
NEXT_PUBLIC_SPECIALIST_EMAILS=
NEXT_PUBLIC_GLOBAL_TEMPLATE_OWNER_EMAIL=
NEXT_PUBLIC_TEST_UNLIMITED_EMAILS=
NEXT_PUBLIC_TEST_TAKE_PRICE_RUB=
NEXT_PUBLIC_ENABLE_PWA=0
# User requested migration without email delivery. Login with passwords stays enabled.
NEXT_PUBLIC_EMAIL_RECOVERY_ENABLED=0

# Payments remain off during migration rehearsal. Go-live is a separate checklist.
PAYMENTS_ENABLED=0
NEXT_PUBLIC_PAYMENTS_ENABLED=0
NEXT_PUBLIC_YOOKASSA_TEST_UI_ENABLED=0

# Add necessary existing server integration settings (payments, Telegram etc.)
# only when enabling each integration on the new production deployment.
